# CarefulClaudeClaw environment configuration
# Copy to .env and fill in your values:
#   cp .env.example .env
#
# .env is gitignored and will never be committed.

# --- Slack ---
# Bot User OAuth Token (xoxb-...)
SLACK_BOT_TOKEN=
# App-Level Token for Socket Mode (xapp-...) — requires connections:write scope
SLACK_APP_TOKEN=
# Your Slack user ID (e.g. U01234567) — only messages from this user are processed
# Find it: Slack → profile → ⋮ → Copy member ID
# Optional but strongly recommended; omitting accepts messages from any user
SLACK_ALLOWED_USER_ID=
