# Local environment overrides for claw-services
# Copy this file to .env and adjust paths for your machine:
#   cp .env.example .env
#
# .env is gitignored and will not be committed.

# Path to the mcp-telegram CLI binary (tg)
# If tg is installed in a virtualenv, provide the full path:
MCP_TELEGRAM_CLI=/path/to/mcp-telegram/.venv/bin/tg
