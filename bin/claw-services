#!/usr/bin/env bash
#
# claw-services — manage CarefulClaw background services
#
# Usage:
#   claw-services start   Start all services
#   claw-services stop    Stop all services
#   claw-services status  Show service status
#   claw-services restart  Restart all services
#   claw-services dev-reset  Stop, wipe DB, clear logs, restart
#   claw-services logs    Tail all logs
#

set -euo pipefail

CLAW_DIR="$(cd "$(dirname "$0")/.." && pwd)"

# Source local environment overrides (gitignored)
if [[ -f "$CLAW_DIR/.env" ]]; then
    set -a
    source "$CLAW_DIR/.env"
    set +a
fi

PID_DIR="$CLAW_DIR/.pids"
LOG_DIR="$CLAW_DIR/.logs"

mkdir -p "$PID_DIR" "$LOG_DIR"

# --- Helpers ---

_is_running() {
    local pid_file="$1"
    if [[ -f "$pid_file" ]]; then
        local pid
        pid=$(cat "$pid_file")
        if kill -0 "$pid" 2>/dev/null; then
            return 0
        fi
    fi
    return 1
}

_pid_of() {
    local pid_file="$1"
    if [[ -f "$pid_file" ]]; then
        cat "$pid_file"
    fi
}

# --- Commands ---

cmd_start() {
    echo "Starting CarefulClaw services..."
    echo

    # claw (scheduler + slack listener)
    if _is_running "$PID_DIR/claw.pid"; then
        echo "  [ok] claw orchestrator (already running, pid $(_pid_of "$PID_DIR/claw.pid"))"
    else
        cd "$CLAW_DIR"
        nohup uv run claw start --slack \
            >> "$LOG_DIR/claw.log" 2>&1 &
        local claw_pid=$!
        echo "$claw_pid" > "$PID_DIR/claw.pid"
        sleep 1
        if _is_running "$PID_DIR/claw.pid"; then
            echo "  [ok] claw orchestrator (pid $claw_pid)"
        else
            echo "  [!!] claw orchestrator (failed to start — check $LOG_DIR/claw.log)"
        fi
    fi

    echo
    echo "Logs: $LOG_DIR/"
}

cmd_stop() {
    echo "Stopping CarefulClaw services..."
    echo

    if _is_running "$PID_DIR/claw.pid"; then
        local pid
        pid=$(_pid_of "$PID_DIR/claw.pid")
        kill "$pid" 2>/dev/null && echo "  [ok] claw orchestrator stopped (pid $pid)"
        rm -f "$PID_DIR/claw.pid"
    else
        echo "  [--] claw orchestrator (not running)"
    fi

    echo
}

cmd_status() {
    echo "CarefulClaw Services"
    echo "--------------------"

    if _is_running "$PID_DIR/claw.pid"; then
        echo "  claw orchestrator  UP   (pid $(_pid_of "$PID_DIR/claw.pid"))"
    else
        echo "  claw orchestrator  DOWN"
    fi

    echo
}

cmd_restart() {
    cmd_stop
    cmd_start
}

cmd_dev_reset() {
    echo "=== CarefulClaw Dev Reset ==="
    echo "This will: stop services, wipe the DB, clear logs, and restart."
    echo
    read -rp "Are you sure? [y/N] " confirm
    if [[ "$confirm" != [yY] ]]; then
        echo "Aborted."
        return
    fi
    echo

    cmd_stop

    # Wipe DB
    cd "$CLAW_DIR"
    uv run claw reset -y
    echo

    # Clear logs
    if [[ -d "$LOG_DIR" ]]; then
        rm -f "$LOG_DIR"/*.log
        echo "  [ok] logs cleared"
        echo
    fi

    cmd_start
}

cmd_logs() {
    local files=()
    [[ -f "$LOG_DIR/claw.log" ]] && files+=("$LOG_DIR/claw.log")

    if [[ ${#files[@]} -eq 0 ]]; then
        echo "No log files found."
        return
    fi

    tail -f "${files[@]}"
}

# --- Main ---

case "${1:-}" in
    start)     cmd_start ;;
    stop)      cmd_stop ;;
    restart)   cmd_restart ;;
    dev-reset) cmd_dev_reset ;;
    status)    cmd_status ;;
    logs)      cmd_logs ;;
    *)
        echo "Usage: claw-services {start|stop|restart|dev-reset|status|logs}"
        exit 1
        ;;
esac
